{
  "name": "auto-merge",
  "version": "0.1.0",
  "description": "Self-hostable GitHub App for automatic cascade merging: main → release → dev",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "8.2.0",
    "croner": "10.0.1",
    "fastify": "5.8.5",
    "fastify-raw-body": "5.0.0",
    "lru-cache": "11.5.0",
    "p-limit": "7.3.0",
    "pino": "10.3.1",
    "probot": "14.3.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22",
    "msw": "2.14.6",
    "pino-pretty": "13.1.3",
    "smee-client": "5.0.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
