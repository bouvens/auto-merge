# auto-merge environment configuration
#
# Usage:
#   cp .env.example .env
#   chmod 600 .env        # restrict read access — this file will contain secrets
#   # Fill in real values below, then:
#   docker compose up -d
#
# Compose reads .env from the working directory automatically.
# NEVER commit .env to git — add it to .gitignore.

# ---------------------------------------------------------------------------
# Caddy / TLS
# ---------------------------------------------------------------------------

# Fully-qualified domain name pointing to this server's IP (A/AAAA record required).
DOMAIN=auto-merge.example.com

# Let's Encrypt will send certificate expiry warnings to this address.
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# GitHub App — required
# ---------------------------------------------------------------------------

# Numeric App ID shown on your GitHub App settings page.
APP_ID=000000

# Webhook secret — at least 16 random characters.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-32-random-chars-min-16

# Private key for the GitHub App.
# Option A (recommended): Paste raw PEM directly.
#   For multi-line PEM in .env, either:
#     a) Wrap in double quotes with \n escapes:  PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
#     b) Set PRIVATE_KEY_PATH to a mounted file path (see Option B).
# Option B: Mount the .pem file into the container and point to it.
#   Set PRIVATE_KEY_PATH=/run/secrets/private_key (or any path accessible inside the container)
#   and leave PRIVATE_KEY unset.
# The app accepts raw PEM or base64-encoded PEM — it decodes either form automatically.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Notifications — optional, delete lines you don't need
# ---------------------------------------------------------------------------

# Slack incoming webhook URL (from api.slack.com/apps → Incoming Webhooks).
# Leave blank or remove to disable Slack notifications.
SLACK_WEBHOOK_URL=

# Telegram bot token from @BotFather.
# Leave blank or remove to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to send notifications to (use @username or numeric chat ID).
TELEGRAM_DEFAULT_CHAT_ID=

# ---------------------------------------------------------------------------
# Diagnostics — optional
# ---------------------------------------------------------------------------

# Bearer token for the /diagnose endpoint (at least 16 characters).
# Leave blank or remove to disable the endpoint entirely.
# Generate with: openssl rand -hex 24
DIAGNOSE_TOKEN=

# ---------------------------------------------------------------------------
# Advanced — only change if you know what you're doing
# ---------------------------------------------------------------------------

# Log verbosity: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL=info
